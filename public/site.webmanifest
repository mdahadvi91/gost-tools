{
  "name": "AHADEX Tools",
  "short_name": "AHADEX",
  "description": "42 free, fast and private online tools for everyday digital tasks.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0A0B1E",
  "theme_color": "#0A0B1E",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities", "productivity", "developer", "multimedia"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/logo/logo-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/images/logo/logo-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Image Tools",
      "short_name": "Image",
      "description": "Convert, compress, resize and crop images",
      "url": "/categories/image",
      "icons": [{ "src": "/images/icons/image-tools.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "PDF Tools",
      "short_name": "PDF",
      "description": "Merge, split, compress and convert PDFs",
      "url": "/categories/pdf",
      "icons": [{ "src": "/images/icons/pdf-tools.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "QR Generator",
      "short_name": "QR",
      "description": "Generate QR codes instantly",
      "url": "/tools/qr-code-generator",
      "icons": [{ "src": "/images/icons/qr-tools.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "JSON Formatter",
      "short_name": "JSON",
      "description": "Format and validate JSON",
      "url": "/tools/json-formatter",
      "icons": [{ "src": "/images/icons/dev-tools.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}