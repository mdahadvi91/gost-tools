# ==========================================================
# AHADEX Tools (gost-tools) — Environment Variables
# Copy this file to .env.local and fill real values.
# NEVER commit .env.local to git.
# ==========================================================

# ---------- Site ----------
VITE_SITE_URL=https://ahadex.fun
VITE_SITE_NAME=AHADEX Tools
VITE_SITE_EMAIL=mdahadvi91@gmail.com
VITE_SITE_DESCRIPTION=42 free, fast and private online tools for everyday digital tasks.
VITE_SITE_GITHUB=https://github.com/mdahadvi91/gost-tools

# ---------- Google Analytics 4 ----------
VITE_GA_MEASUREMENT_ID=

# ---------- Google AdSense ----------
# Fill after AdSense approval
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_HEADER=
VITE_ADSENSE_SLOT_IN_ARTICLE=
VITE_ADSENSE_SLOT_FOOTER=

# ---------- Contact Form ----------
# Formspree / Web3Forms endpoint
VITE_CONTACT_FORM_ENDPOINT=

# ---------- Cloudflare Turnstile ----------
VITE_TURNSTILE_SITE_KEY=

# ---------- Feature Flags ----------
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ADSENSE=false
VITE_ENABLE_SOUND=true
VITE_ENABLE_ANIMATIONS=true
VITE_ENABLE_BACKGROUND_REMOVER=false

# ---------- Debug ----------
VITE_DEBUG_MODE=false